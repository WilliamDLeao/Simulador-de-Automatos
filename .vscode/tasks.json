{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar e Rodar",
      "type": "shell",
      "command": "./run.sh",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Compilar (make)",
      "type": "shell",
      "command": "make",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Limpar (make clean)",
      "type": "shell",
      "command": "make clean",
      "problemMatcher": []
    }
  ]
}
